{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    // Vitest's own `expect<T>(actual: T, message?: string)` accepts an optional second argument
    // (see `@vitest/expect`'s type definitions) that this codebase uses to label which loop
    // iteration failed. The rule's default `maxArgs: 1` is a Jest-era assumption that does not
    // hold for Vitest's real signature.
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    // `main.ts`'s `main().then(onSuccess, onError)` is the terminal handler of the whole
    // program's promise chain (nothing chains off it — it only sets `process.exitCode`), which is
    // exactly the case this option exists for.
    "promise/always-return": ["error", { "ignoreLastCallback": true }],
    // `__dirname` reconstructed via `dirname(fileURLToPath(import.meta.url))` is the standard
    // Node ESM idiom for the removed CommonJS global, not a private-by-convention identifier.
    // `_multiCache` is `compromise`'s own internal lexicon property name (`world.model.one._multiCache`,
    // see `src/core/pos-tags.ts`), not a name this codebase chose.
    "eslint/no-underscore-dangle": ["error", { "allow": ["__dirname", "_multiCache"] }]
  }
}
