{
  "description": "Blocks Write/Edit calls that add a ste-ai lint finding to a lowercase .md file.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/block-noncompliant-prose.cjs"],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
