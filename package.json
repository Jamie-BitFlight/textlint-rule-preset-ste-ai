{
  "name": "textlint-rule-preset-ste-ai",
  "version": "0.1.0",
  "description": "Auditable Simplified Technical English linter for textlint: deterministic rules plus an optional local llama.cpp semantic-adjudication subsystem. Not certified for, and does not claim, ASD-STE100 conformance.",
  "license": "MIT",
  "author": "Jamie Nelson",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "./dist/textlint/preset.js",
  "types": "./dist/textlint/preset.d.ts",
  "exports": {
    ".": {
      "types": "./dist/textlint/preset.d.ts",
      "default": "./dist/textlint/preset.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./rule-pack": {
      "types": "./dist/rule-pack/index.d.ts",
      "default": "./dist/rule-pack/index.js"
    },
    "./deterministic": {
      "types": "./dist/deterministic/index.d.ts",
      "default": "./dist/deterministic/index.js"
    },
    "./semantic": {
      "types": "./dist/semantic/index.d.ts",
      "default": "./dist/semantic/index.js"
    },
    "./model-client": {
      "types": "./dist/model-client/index.d.ts",
      "default": "./dist/model-client/index.js"
    },
    "./fixture-tools": {
      "types": "./dist/fixture-tools/index.d.ts",
      "default": "./dist/fixture-tools/index.js"
    },
    "./prompts/*": "./prompts/*",
    "./textlint": {
      "types": "./dist/textlint/index.d.ts",
      "default": "./dist/textlint/index.js"
    },
    "./analysis": {
      "types": "./dist/analysis/analyse.d.ts",
      "default": "./dist/analysis/analyse.js"
    },
    "./evaluation": {
      "types": "./dist/evaluation/index.d.ts",
      "default": "./dist/evaluation/index.js"
    }
  },
  "bin": {
    "ste-ai": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "prompts",
    "docs/DISCLAIMER.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist .tsbuildinfo coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:fixtures": "vitest run test/fixtures",
    "test:e2e": "npm run build && vitest run test/e2e",
    "test:coverage": "vitest run --coverage",
    "fixtures:fetch": "node scripts/fetch-sources.mjs",
    "fixtures:validate": "npm run build && node scripts/validate-fixtures.mjs",
    "eval:semantic": "npm run build && node scripts/evaluate-semantic.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run fixtures:validate",
    "prepublishOnly": "npm run clean && npm run build",
    "build:clean": "npm run clean && npm run build"
  },
  "keywords": [
    "textlint",
    "textlintrule",
    "simplified-technical-english",
    "ste",
    "controlled-language",
    "technical-writing",
    "llama.cpp"
  ],
  "peerDependencies": {
    "textlint": ">=13"
  },
  "peerDependenciesMeta": {
    "textlint": {
      "optional": true
    }
  },
  "dependencies": {
    "@textlint/ast-node-types": "^15.7.1",
    "@textlint/markdown-to-ast": "^15.7.1",
    "sentence-splitter": "^5.0.1",
    "text-readability": "^1.1.1",
    "zod": "^4.1.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@textlint/types": "^15.7.1",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^10.8.0",
    "prettier": "^3.6.2",
    "textlint": "^15.7.1",
    "textlint-tester": "^15.7.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
