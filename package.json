{
  "name": "textlint-rule-preset-ste-ai",
  "version": "0.1.0",
  "description": "Auditable Simplified Technical English linter for textlint: deterministic rules plus an optional local llama.cpp semantic-adjudication subsystem. Not certified for, and does not claim, ASD-STE100 conformance.",
  "keywords": [
    "controlled-language",
    "llama.cpp",
    "simplified-technical-english",
    "ste",
    "technical-writing",
    "textlint",
    "textlintrule"
  ],
  "license": "MIT",
  "author": "Jamie Nelson",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jamie-BitFlight/textlint-rule-preset-ste-ai.git"
  },
  "bin": {
    "ste-ai": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "prompts",
    "docs/DISCLAIMER.md",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/textlint/preset.js",
  "types": "./dist/textlint/preset.d.ts",
  "exports": {
    ".": {
      "types": "./dist/textlint/preset.d.ts",
      "default": "./dist/textlint/preset.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./rule-pack": {
      "types": "./dist/rule-pack/index.d.ts",
      "default": "./dist/rule-pack/index.js"
    },
    "./deterministic": {
      "types": "./dist/deterministic/index.d.ts",
      "default": "./dist/deterministic/index.js"
    },
    "./semantic": {
      "types": "./dist/semantic/index.d.ts",
      "default": "./dist/semantic/index.js"
    },
    "./model-client": {
      "types": "./dist/model-client/index.d.ts",
      "default": "./dist/model-client/index.js"
    },
    "./fixture-tools": {
      "types": "./dist/fixture-tools/index.d.ts",
      "default": "./dist/fixture-tools/index.js"
    },
    "./prompts/*": "./prompts/*",
    "./textlint": {
      "types": "./dist/textlint/index.d.ts",
      "default": "./dist/textlint/index.js"
    },
    "./analysis": {
      "types": "./dist/analysis/analyse.d.ts",
      "default": "./dist/analysis/analyse.js"
    },
    "./evaluation": {
      "types": "./dist/evaluation/index.d.ts",
      "default": "./dist/evaluation/index.js"
    }
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "clean": "rm -rf dist coverage",
    "check": "vp check",
    "lint": "vp lint",
    "format": "vp fmt",
    "test": "vp test",
    "test:unit": "vp test test/unit",
    "test:integration": "vp test test/integration",
    "test:fixtures": "vp test test/fixtures",
    "test:e2e": "vp run build && vp test test/e2e",
    "test:coverage": "vp test --coverage",
    "fixtures:fetch": "node scripts/fetch-sources.mjs",
    "fixtures:validate": "vp run build && node scripts/validate-fixtures.mjs",
    "eval:semantic": "vp run build && node scripts/evaluate-semantic.mjs",
    "verify": "vp check && vp test && vp run fixtures:validate",
    "prepublishOnly": "vp run clean && vp run build"
  },
  "dependencies": {
    "@textlint/ast-node-types": "^15.8.0",
    "@textlint/markdown-to-ast": "^15.8.0",
    "compromise": "^14.16.0",
    "sentence-splitter": "^5.0.1",
    "text-readability": "^1.1.1",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@textlint/kernel": "^15.8.0",
    "@textlint/textlint-plugin-markdown": "^15.8.0",
    "@textlint/textlint-plugin-text": "^15.8.0",
    "@textlint/types": "^15.8.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "semantic-release": "^25.0.9",
    "textlint": "^15.8.0",
    "textlint-tester": "^15.8.0",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "0.2.9",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "textlint": ">=13"
  },
  "peerDependenciesMeta": {
    "textlint": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.5.1"
}
